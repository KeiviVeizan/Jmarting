  {
    id:1,
    title:"Oficina central",
    description:"Telefono",
    telf:[{num:"73717346", href:""}],
    mail:[{gmail:"kveizanp@est.emi.edu.bo", href:"/"}],
  },
{
    id:2,
    title:"",
    description:"",
    telf:[{num:"73717346", href:""}],

  },
{
    id:3,
    title:"",
    description:"",
    telf:[{num:"73717346", href:""}],

  },

]
import Encabezado from "../Components/Encabezado.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const { title = 'Default Title' } = Astro.props;
---
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png+xml" href="/logo-simple.png" />
  <title>Contacto</title>
</head>
<body>
    <BaseLayout>
        <Encabezado image="/images/contacto-section.png" title="CONTACTO"/>
        <section class="inf1-contacto">
          <article>
            <fieldset>
              <legend>Contactate</legend>
              <div class="contact">
                {
                  MoreInformationContact.map((contact)=>(
                    <div class={`inf-contact inf-contact${contact.id}`}>
                      <h3>{contact.title}</h3>
                      <p>{contact.description}</p>
                      <div class="links">
                        {
                          contact.mail?.map((mails)=>(
                            <a href={mails.href}>{mails.gmail}</a>
                          ))
                        }
                        {
                          contact.telf?.map((number)=>(
                            <a href={number.href}>{number.num}</a>
                          ))
                        }
                      </div>
                    </div>
                  ))
                }
              </div>
            </fieldset>
          </article>
          <article>
            <form action="" method="get" class="about-contact">
            <fieldset>
                <legend>Nos contactamos contigo</legend>
                <input type="text" name="nombre" placeholder="Nombre" required="True">
                <input type="email" placeholder="Correo Electronico" name="correo" required="True">
                <input type="number" placeholder="Numero de Telefono" name="telefono" required="true">
                <textarea name="Mensaje" id="" placeholder="Mensaje" rows="3"></textarea>
                <input type="submit" value="Enviar">
              </fieldset>
            </form>
          </article>
        </section>
    </BaseLayout>
</body>
</html>
