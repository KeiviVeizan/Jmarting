    title:"Prueba",
    telf:[{num:"73717346", href:"https://w.app/bhl93a"}],
    mail:[{gmail:"kveizanp@est.emi.edu.bo", href:"/"}]
  },

]
import Encabezado from "../Components/Encabezado.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

---
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png+xml" href="/logo-simple.png" />
  <title>Contacto</title>
</head>
<body>
    <BaseLayout>
        <Encabezado image="/images/contacto-section.png" title="CONTACTO"/>
        <section class="inf1-contacto">
          <article class="inf-contact1">
            <fieldset>
              <legend>Contactate</legend>
              <div class="contact">
                {
                  MoreInformationContact.map((contact)=>(
                    <div class={`inf-contact inf-contact${contact.id}`}>
                      <h3>{contact.title}</h3>
                      <div class="links">
                        {
                          contact.mail?.map((mails)=>(
                            <div class="correo">
                              <h4>Correo: </h4>
                              <a href={mails.href} target="_blank">{mails.gmail}</a>
                            </div>
                          ))
                        }
                        
                        {
                          contact.telf?.map((number)=>(
                            <div class="telefono">
                              <h4>Telefono: </h4>
                              <a href={number.href} target="_blank">{number.num}</a>
                            </div>
                          ))
                        }
                      </div>
                    </div>
                  ))
                }
              </div>
            </fieldset>
          </article>
          <article class="inf-contact2">
            <form action="" method="get" class="about-contact">
            <fieldset>
                <legend>Nos contactamos contigo</legend>
                <div class="formulario-contact">
                  <input type="text" name="nombre" placeholder="Nombre" required="True">
                  <input type="email" placeholder="Correo Electronico" name="correo" required="True">
                  <input type="number" placeholder="Numero de Telefono" name="telefono" required="true">
                  <textarea name="Mensaje" id="" placeholder="Mensaje" rows="3"></textarea> <br>
                  <input type="submit" value="Enviar" id="Enviar">
                </div>
              </fieldset>
            </form>
          </article>
        </section>
    </BaseLayout>
</body>
</html>
<style>
  *{
    margin: 0;
    padding: 0;
    bottom: 0;
  }
  .inf1-contacto{
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }
  legend{
    font-size: 1.5rem;
    color:#3E458D;
    font-family: "Lato", sans-serif;
		font-weight: 900;
  }
  fieldset{
    width: 300px;
    border: 2px solid #F4B631;
  }
  article{
    margin: 2rem 0rem;
  }
  .inf-contact{
    padding: .5rem;
  }
  .correo, .telefono{
    display: flex;
    flex-direction: row;
    margin: .5rem;
  }
  .inf-contact h3, h4{
    color: #3E458D;
    font-family: "Lato", sans-serif;
    font-weight: 700;
  }
  .links a{
    color: #2d2d2d;
    transition: color, .5s;
    font-family: "Lato", sans-serif;
    font-weight: 300;
  }
  .links a:hover{
    color: #F4B631;
  }
  .formulario-contact{
    padding: .5rem;
  }
  .formulario-contact input, textarea{
    margin:.5rem 0rem;
  }
  .formulario-contact #Enviar{
    background-color: #3E458D;
    padding: .5rem 2rem;
    color: white;
    border-radius: .3rem;
    transition: background-color, .5s;
  }
  .formulario-contact #Enviar:hover{
    background-color: #F4B631;
    color: #3E458D;
  }
  @media(min-width:375px){

  }
  @media(min-width:425px){
    
  }
  @media(min-width:768px){
    .inf1-contacto{
      justify-content: space-around;
    }
  }
  @media(min-width:375px){
    
  }
</style>