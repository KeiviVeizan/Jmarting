---
import Encabezado from "../Components/Encabezado.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const MoreInformationProduct = [
  {
    id:1,
    image:"/images/logo-guerbet.png",
    link:"/Productos/guerbet"
  },
  {
    id:2,
    image:"/images/logo-aptissen.webp",
    link:"/Productos/aptissen"
  },
  {
    id:3,
    image:"/images/logo-temi.png",
    link:"/Productos/termis"
  },
  {
    id:4,
    image:"/logo-principal.png",
    link:"/Productos/farmavone"
  },
  {
    id:5,
    image:"/images/logo-mhj.png",
    link:"/Productos/mhj"
  },{
    id:6,
    image:"/images/equipos-medicos.png",
    link:"/Productos/EquiposMedicos"
  }
]


const { title = 'Default Title' } = Astro.props;
---
<html lang="es">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/png+xml" href="/logo-simple.png" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Productos</title>
</head>
<body>
    <BaseLayout>
        <Encabezado image="/images/product-section.png" title="PRODUCTOS"/>
        <section class="product-inf">
          {MoreInformationProduct.map((product)=>(
            <a href={product.link} class="inf-link">
              <article class={` inf-product inf-product${product.id}`}>
                <img src={product.image} alt="Imagen de formulario">
                <div class="product-before"></div>
              </article>
            </a>
          )) 
          }
    </section>
    </BaseLayout>
</body>
</html>
<style>
  .product-inf{
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    width: 90%;
    margin: auto;
  }
  .inf-product a{
    width: 18rem;
    height: 10rem;
    object-fit: cover;
    z-index: 3;

  }
  .inf-product{
    position: relative;
    width: 250px;
    height: 25vh;
    min-height: 180px;
    max-height: 400px;
    overflow: hidden;
    margin: 2rem;
    border-radius: 1rem;
    box-shadow: 0px 10px 14px #3e3e3e;
    transition: all .4s ease;
    opacity: 0;
    animation: fadeInScale 0.6s ease-out forwards;
  }
  .inf-product:nth-child(1) { animation-delay: 0.1s; }
  .inf-product:nth-child(2) { animation-delay: 0.2s; }
  .inf-product:nth-child(3) { animation-delay: 0.3s; }
  .inf-product:nth-child(4) { animation-delay: 0.4s; }
  .inf-product:nth-child(5) { animation-delay: 0.5s; }
  .inf-product:nth-child(6) { animation-delay: 0.6s; }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .inf-product:hover{
    transform: scale(1.05) translateY(-10px);
    box-shadow: 0px 20px 30px rgba(62, 69, 141, 0.4);
  }
  .inf-product img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    z-index: -2;
  }
  .product-before{
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    transition: opacity, 1s;
  }
  .product-before:hover{
    background-color: #1c1c1d;
    opacity: 0.7;
  }
  .inf-link{
    text-decoration: none;
    display: inline-block;
  }

  @media(min-width:375px){
    .inf-product{
      width: 20rem;
    }
    .inf-product a{
      width: 20rem;
    }
  }
    @media(min-width:425px){
    .inf-product, .inf-product a|{
      width: 22rem;
    }
  }
</style>