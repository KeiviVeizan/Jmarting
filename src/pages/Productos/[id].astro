        image: "/images/logo-guerbet.png",
        link: "https://go.guerbet.com/l/709593/2022-07-07/33y6sr"
      },
      {
        title: "Artirem®",
        description: "Ácido gadotérico Lanzado por primera vez en 2002 en Francia, Artirem® se comercializa en 15 países.",
        image: "/images/logo-guerbet.png",
        link: "https://go.guerbet.com/l/709593/2022-07-07/33y6sr"
      },
      {
        title: "Artirem®",
        description: "Ácido gadotérico Lanzado por primera vez en 2002 en Francia, Artirem® se comercializa en 15 países.",
        image: "/images/logo-guerbet.png",
        link: "https://go.guerbet.com/l/709593/2022-07-07/33y6sr"
      },
      {
        title: "Artirem®",
        description: "Ácido gadotérico Lanzado por primera vez en 2002 en Francia, Artirem® se comercializa en 15 países.",
        image: "/images/logo-guerbet.png",
        link: "https://go.guerbet.com/l/709593/2022-07-07/33y6sr"
      },
      {
        title: "Artirem®",
        description: "Ácido gadotérico Lanzado por primera vez en 2002 en Francia, Artirem® se comercializa en 15 países.",
        image: "/images/logo-guerbet.png",
        link: "https://go.guerbet.com/l/709593/2022-07-07/33y6sr"
      }


    ]
  },
  aptissen: {
    title: "PRODUCTOS APTISSEN",
    products: [
      {
        title: "Empresas Médicas",
        description: "Este formulario está dirigido a empresas del área médica...",
        image: "/images/reporte-medicas.png",
        link: "/"
      }
    ]
  },
  mhj: {
    title: "PRODUCTOS MHJ",
    products: [
      {
        title: "Formulario de profesional de salud",
        description: "Formulario específico para profesionales del área médica...",
        image: "/images/reporte-profesional-salud.png",
        link: "/"
      }
    ]
  },
  farmavone: {
    title: "PRODUCTOS FARMAVONE",
    products:[
      {
        title: "Farmacovigilancia AGEMED",
        description: "Reporta cualquier evento adverso a través de AGEMED...",
        image: "/images/farmacovigilancia-section.png",
        link: "/"
      }
    ]
  },
  termis: {
    title: "PRODUCTOS TERMIS",
    products:[
      {
        title: "Quejas y Reclamos",
        description: "Puedes presentar tus quejas y reclamos aquí...",
        image: "/images/reporte-quejas-reclamos.png",
        link: "/"
      }
    ]
  },
};

const selected = contentMap[id];

if (!selected) {
  throw new Error(`Formulario con id "${id}" no encontrado.`);
}
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{selected.title}</title>
  </head>
  <body>
    <BaseLayout>
      <Encabezado image="/images/product-section.png" title={selected.title} />

      <section style="display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; padding: 2rem;">
        {
          selected.products.map((item) => (
              <article style="width: 300px; border: 1px solid #ccc; border-radius: 1rem; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); padding: 1rem; background: #fff;">
                <img src={item.image} alt={item.title} style="width: 100%; height: auto;" />
                <h3 style="margin-top: 1rem;">{item.title}</h3>
                <p>{item.description}</p>
                <a href={item.link} target="_blank" style="display: inline-block; margin-top: 0.5rem; color: blue;">Ver más</a>
              </article>
            ))
        }
      </section>
    </BaseLayout>
  </body>
</html>
