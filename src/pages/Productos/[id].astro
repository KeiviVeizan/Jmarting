---
import Encabezado from '../../Components/Encabezado.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return [
    { params: { id: "guerbet" } },
    { params: { id: "aptissen" } },
    { params: { id: "mhj" } },
    { params: { id: "farmavone" } },
    { params: { id: "termis" } },
  ];
}

const { id } = Astro.params;

const contentMap = {
  guerbet: {
    title: "Productos Guerbet",
    products: [
      {
        title: "Dotarem®",
        description: "Ácido gadotérico – Gadoterato de meglumina Lanzado en 1989 en Francia, Dotarem® está actualmente disponible en más de 70 países",
