<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Bebas+Neue&family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
		<link rel="icon" type="image/png+xml" href="/logo-simple.png" />
    <title>{selected.title}</title>
  </head>
  <body>
    <BaseLayout>
      <Encabezado image="/images/product-section.png" title={selected.title} />

      <section class="card">
        {
          selected.products.map((item: any) => (
              <article class="cart-product">
                <img src={item.image} alt={item.title}/>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <a href={item.link} target="_blank" >Ver más información del producto</a>
              </article>
            ))
        }
      </section>
    </BaseLayout>
  </body>
</html>
<style>
  .card{
    display: flex; 
    flex-wrap: wrap; 
    justify-content: center; 
    gap: 2rem; 
    padding: 2rem;
  }
  .cart-product{
    width: 300px;
    min-height: 500px;
    border: 1px solid #ccc;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 1rem;
    background: #fff;
    font-family: "Lato", sans-serif;
    display: flex;
    flex-direction: column;

    view-timeline-name: --card;
    view-timeline-axis: block;
    animation-timeline: --card;
    animation-name: show;
    animation-range: entry 25% cover 50%;
    animation-fill-mode: both;
  }
  .cart-product img{
    width: 100%;
    height: auto;
    aspect-ratio: 1/1;
    object-fit: contain;
  }
  .cart-product h3{
    margin-top: 1rem;
    font-weight: 900;
    height: 3rem;
    display: flex;
    align-items: center;
  }
  .cart-product p{
    font-weight: 300;
    overflow: hidden;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 6;
  }
  .cart-product a{
    display: inline-block;
    margin-top: auto;
    color: #3E458D;
    transition: color .5s;
  }
  .cart-product a:hover{
    color: #DA3A32;
  }

  @keyframes show {
    from{
      opacity: 0;
      scale: 25%;
    }
    to{
      opacity: 1;
      scale: 100%;
    }
    
  }
</style>
