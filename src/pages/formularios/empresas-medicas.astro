---
import Encabezado from "../../Components/Encabezado.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

---
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Formulario para Empresas Médicas</title>
</head>
<body>
  <BaseLayout>
    <Encabezado image="/images/farmacovigilancia-section.png" title="EMPRESAS MÉDICAS"/>
    <section class="Form-empreas">
        <h2>
            REPORTE DE SOSPECHA DE REACCIONES ADVERSAS A MEDICAMENTOS POR LAS EMPRESAS FARMACEUTICAS
        </h2>
        <form action="https://formsubmit.co/Carla_reinaga@jmarting.com" method="POST">
            <fieldset>
                <legend>Empresas Médicas</legend>
                <div class="form-group">
                    <label for="notificacion">Nº DE NOTIFICACION DE LA EMPRESA</label>
                    <input type="number" name="numero-notificacion-empresa" id="notificacion" required="True">
                </div>
                <div class="form-group">
                    <label for="noti">Nº DE NOTIFICACION</label>
                    <input type="number" name="numero-notificacion" id="noti" required="True">
                </div>
                <div class="form-group">
                    <label for="opcion">SELECCIONAR UNA OPCIÓN</label>
                    <select name="medicamento" id="opcion" required="True">
                        <option value=""></option>
                        <option value="Medicamento-Estudio">Medicamento Registrado</option>
                        <option value="Medicamento-Registrado">Medicamento en Estudio</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="otra-via">RAM HA SIDO COMUNICADA POR OTRA VIA</label>
                    <select name="comunicado-por-otra-via" id="otra-via" required="True">
                        <option value=""></option>
                        <option value="Si">Si</option>
                        <option value="No">No</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="indicar">SI RESPONDIÓ SI, DEBE INDICAR LA VIA</label>
                    <textarea name="via-comunicada" id="indicar" required="True"></textarea>
                </div>
            </fieldset>
            <fieldset>
                <legend>I. INFORMACION SOBRE LA REACCION ADVERSA</legend>
                <div class="form-group">
                    <label for="identificacion">Código de Identificación del Paciente</label>
                    <input type="text" name="codigo-paciente" id="identificacion"required=True>
                </div>
                <div class="form-group">
                    <label for="sexo">Sexo:</label>
                    <select name="sexo" id="sexo" required="True">
                        <option value=""></option>
                        <option value="Masculino">Masculino</option>
                        <option value="Femenino">Femenino</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="peso">Peso:</label>
                    <input type="number" step="any" name="peso" id="peso" required="True">
                </div>
                <div class="form-group">
                    <label for="estatura">Estatura:</label>
                    <input type="number" step="any" name="estatura" id="estatura" required="True">
                </div>
                <div class="form-group">
                    <label for="fecha-inicio">Fecha de inicio de la RAM (dd/mm/aa)</label>
                    <input type="date" name="fecha de inicio" id="fecha-inicio" required="True">
                </div>
                <div class="form-group">
                    <label for="descripcion">DESCRIPCION DE LA(s) REACCION(es) ADVERSA(s)</label>
                    <textarea name="descripcion-reacciones" id="descripcion" required="True" placeholder="Incluye resultados relevantes de exámenes auxiliares y la fecha de finalización, si procede"></textarea>
                </div>
                <div class="form-group">
                    <label for="desenlace">DESENLACE</label>
                    <select name="deselace" id="desenlace" required="True">
                        <option value="Fatal">Fatal</option>
                        <option value="Riesgo">Puso en grave riesgo la vida del paciente</option>
                        <option value="Requirió hopitalización">Requirió hopitalización</option>
                        <option value="Prolongó hospitalización">Prolongó hospitalización</option>
                        <option value="incapacidad permanente">Produjo incapacidad permanente</option>
                        <option value="Recuperación total">Recuperación total</option>
                        <option value="otro">Otro</option>
                    </select>
                </div>
            </fieldset>
            <fieldset>
                <legend>II. INFORMACION DEL MEDICAMENTO SOSPECHOSO DE LA EMPRESA</legend>
                <div class="form-group">
                    <label for="name">Nombre comercial o gen.</label>
                    <input type="text" name="nomnre-comercial" id="name" required="True">
                </div>
                <div class="form-group">
                    <label for="fabricante">Fabricante y país</label>
                    <input type="text" name="fabricante" id="fabricante" required="True">
                </div>
                <div class="form-group">
                    <label for="lote">Lote</label>
                    <input type="text" name="lote" id="lote" required="True">
                </div>
                <div class="form-group">
                    <label for="dosis">Dosis Diaria</label>
                    <input type="number" name="dosis-diaria" id="dosis" required="True">
                </div>
                <div class="form-group">
                    <label for="adm">Vía administrada</label>
                    <input type="text" name="via-administrada" id="adm" required="True">
                </div>
                <div class="form-group">
                    <label for="motivo">Motivo de Prescripción</label>
                    <input type="text" name="motivo-prescripcion" id="motivo" required="True">
                </div>
                <div class="form-group">
                    <label for="fecha-inicio">Fecha inicio dd/mm/aa</label>
                    <input type="date" name="fecha-inicio" id="fecha-inicio" required="True">
                </div>
                <div class="form-group">
                    <label for="fecha-final">Fecha final dd/mm/aa</label>
                    <input type="date" name="fecha-final" id="fecha-final" required="True">
                </div>
                <div class="form-group">
                    <label for="reaccion">¿Remitió la reacción al suspender medicación?</label>
                    <select name="remitio-reaccion-suspender" id="reaccion" required="True">
                        <option value=""></option>
                        <option value="Si">Si</option>
                        <option value="No">No</option>
                        <option value="No procede">No Procede</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="reducir">¿Remitió la reacción al reducir la dosis?</label>
                    <select name="remitio-reaccion-reducir" id="reducir" required="True">
                        <option value=""></option>
                        <option value="Si">Si</option>
                        <option value="No">No</option>
                        <option value="No procede">No Procede</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="">¿Reapareció la reacción al administrar de nuevo el medicamento?</label>
                    <select name="remitio-reaccion-administrar" id="" required="True">
                        <option value=""></option>
                        <option value="Si">Si</option>
                        <option value="No">No</option>
                        <option value="No procede">No Procede</option>
                    </select>
                </div>                 
            </fieldset>
            <fieldset>
                <legend>III. MEDICAMENTOS CONCOMITANTES E HISTORIA CLINICA</legend>
                <div class="form-group">
                    <label for="nombre-comercial">Nombre comercial o genérico</label>
                    <input type="text" name="nombre-comercial" id="nombre-comercial" required="True">
                </div>
                <div class="form-group">
                    <label for="fabricante">Fabricante y Pais</label>
                    <input type="text" name="fabricante-pais" id="fabricante" required="True">
                </div>
                <div class="form-group">
                    <label for="dosis">Dosis Diaria</label>
                    <input type="text" name="dosis-diaria" id="dosis" required="True">
                </div>
                <div class="form-group">
                    <label for="via-adm">Via Administrativa</label>
                    <input type="text" name="via-administrativa" id="via-adm " required="True">
                </div>
                <div class="form-group">
                    <label for="fecha-inicio">Fecha de Inicio dd/mm/aa</label>
                    <input type="date" name="fecha-inicio" id="fecha-inicio" required="True">
                </div>
                <div class="form-group">
                    <label for="fecha-final">Fecha de final dd/mm/aa</label>
                    <input type="date" name="fecha-final" id="fecha-final" required="True">
                </div>
                <div class="form-group">
                    <label for="datos-importantes">Datos importantes de la Historia Clínica</label>
                    <textarea name="datos-importantes-historia-clinica" id="datos-importantes" placeholder="Ej. Otros diagnósticos, alergias, embarazo, vacunas, transfusiones de sangre, cirugía, etc..." required="True"></textarea>
                </div>
            </fieldset>
            <fieldset>
                <legend>IV. INFORMACION SOBRE LA EMPRESA Y PROCEDENCIA DE LA RAM</legend>
                <div class="form-group">
                    <label for="nombre-empresa">Nombre de la empresa y teléfono</label>
                    <textarea name="nombre-telefono-empresa" id="nombre-empresa" required="True"></textarea>
                </div>
                <div class="form-group">
                    <label for="responsable">Responsable de FCVG de la Empresa</label>
                    <input type="text" name="responsable-fcvg" id="responsable" required="true">
                </div>
                <div class="form-group">
                    <label for="evaluacion-causalidad">Evaluación de la causalidad por parte del responsable de FCVG en la Empresa</label>
                    <input type="text" name="evaluacion-causalidad-fcvg" id="evaluacion-causalidad" required="true">
                </div>
                <div class="form-group">
                    <label for="fecha-recepcion">Fecha recepción en la Empresa</label>
                    <input type="date" name="fecha-recepcion" id="fecha-recepcion" required="True">
                </div>
                <div class="form-group">
                    <label for="fuente-informacion">Fuente de información</label>
                    <select name="fuente-informacion" id="fuente-informacion" required="True">
                        <option value=""></option>
                        <option value="Estudio">Estudio</option>
                        <option value="Publicacion">Publicación</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="tipo-informe">Tipo de informe</label>
                    <select name="tipo-informe" id="tipo-informe" required="True">
                        <option value=""></option>
                        <option value="Inicial">Inicial</option>
                        <option value="Seguimiento">Seguimiento</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="fecha-noti">Fecha de notificación al AGEMED</label>
                    <input type="text" name="fecha-notificacion-agemed" id="fecha-noti" required="True">
                </div>
                <div class="form-group">
                    <label for="noti">Notificación Espontánea Iniciales</label>
                    <input type="text" name="notificacion-espontane" id="noti" required="True">
                </div>
                <div class="form-group">
                    <label for="profesion">Profesión</label>
                    <input type="text" name="profesion" id="profesion" required="True">
                </div>
                <div class="form-group">
                    <label for="origen">Origen</label>
                    <select name="origen" id="origen" required="True">
                        <option value=""></option>
                        <option value="Hospotalario">Hospotalario</option>
                        <option value="Estrahospitalario">Estrahospitalario</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="pais">País</label>
                    <input type="text" name="pais" id="pais" required="True">
                </div>
                <div class="form-group">
                    <label for="departamento">Departamento</label>
                    <input type="text" name="departamento" id="departamento" required="True">
                </div>
                <div class="form-group">
                    <label for="provincia">Provincia</label>
                    <input type="text" name="provincia" id="provincia" required="True">
                </div>
            </fieldset>
            <input type="submit" value="ENVIAR DATOS AHORA" id="enviar">
        </form>
    </section>
  </BaseLayout>
</body>
</html>
<style>
    * {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: "Lato", sans-serif;
  background-color: #f9f9f9;
  color: #222;
  padding: 2rem;
}

.Form-empreas {
  max-width: 1200px;
  margin: 2rem auto;
  padding: 2rem;
  background-color: white;
  box-shadow: 0 0 10px rgba(0,0,0,0.1);
  border-radius: 8px;
}

.Form-empreas h2 {
  text-align: center;
  font-weight: 700;
  font-size: 1.4rem;
  margin-bottom: 2rem;
}

form {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

fieldset {
  border: 2px solid #d1d1d1;
  padding: 1.5rem;
  border-radius: 8px;

  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

legend {
  font-weight: bold;
  padding: 0 10px;
  font-size: 1rem;
  margin-bottom: 1rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  flex: 1 1 100%;
}

.form-group label {
  font-weight: 600;
  font-size: 0.95rem;
  margin-bottom: 0.4rem;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 10px;
  font-size: 0.9rem;
  border: 1px solid #ccc;
  border-radius: 6px;
}

textarea {
  resize: vertical;
  min-height: 80px;
}

input[type="submit"] {
  background-color: #DA3A32;
  color: white;
  font-weight: bold;
  padding: 1rem;
  border: none;
  border-radius: 6px;
  font-size: 1rem;
  cursor: pointer;
  margin-top: 2rem;
  transition: background-color 0.3s ease;
}

input[type="submit"]:hover {
  background-color: #F4B631;
}


@media (min-width: 600px) {
  .form-group {
    flex: 1 1 calc(50% - 1rem);
  }

  .form-group.full-width {
    flex: 1 1 100%;
  }
}

@media (min-width: 992px) {
  .form-group {
    flex: 1 1 calc(33.333% - 1rem);
  }

  .form-group.full-width {
    flex: 1 1 100%;
  }
}

</style>
