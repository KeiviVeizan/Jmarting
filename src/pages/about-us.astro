---
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png+xml" href="/logo-simple.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Bebas+Neue&family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
  <title>Acerca de Nosotros</title>
</head>
<body>
    <BaseLayout>
        <Encabezado image="/images/Acerca-de-nosotros.png" title="ACERCA DE NOSOTROS"/>
        <section class="section1-about-inf">
            {
                MoreInformationAboutUs.map((about)=>(
                    <article class={`about-inf about-inf${about.id}`}>
                        <div class="about-inf-text">
                            <h3>{about.title}</h3>
                            <p>{about.descrition}</p>
                        </div>
                        <img src={about.image} alt="Imagen de Acerca de Nosotros">
                    </article> 
                ))
            }
        </section>
        <section class="section2-about-inf">
            <h2>
                Nuestras Empresas Afiliadas
            </h2>
            <article class="section2-inf-bottom">
                {
                    InformationAfiliados.map((afiliados)=>(
                        <div class={`afiliados-inf afiliados-inf${afiliados.id}`}>
                            <a href={afiliados.link} target="_blank">
                                <img src={afiliados.image} alt="Imagen de Las empresas afiliadas">
                            </a>
                        </div>
                    ))
                }
            </article>
        </section>
        <!--
        <section class="section3-about-inf">
            <h2>
                    Equipo de Trabajo
            </h2>
            <article class="team-work">
                {
                    InformationTeamWork.map((teamwork)=>(
                        <div class={`team-work-inf team-work-inf${teamwork.id}`}>
                            <img src={teamwork.image} alt="Imagen del equipo de trabajo">
                            <h4>{teamwork.name}</h4>
                            <div class="cargo-work">
                                <p>{teamwork.cargo}</p>
                                <a href={teamwork.link}>
                                    <img src="/images/linkedin-work.png" alt="Linkedin">
                                </a>
                            </div>
                        </div>
                    ))
                }
            </article>
        </section>
        -->
    </BaseLayout>
</body>
</html>
<style>
    body{
        background: #F2F2F2;
    }
    body h2{
        text-align: center;
        font-size: 2rem;
    }
    .section1-about-inf{
		width: 90%;
		margin:auto;
	}
	.about-inf{
		display: flex;
		flex-direction: column;
		align-items: center;
		margin: 2rem 0rem;
	}
	.about-inf h3{
		font-family: "Lato", sans-serif;
		font-weight: 900;
        color: #3E458D;
	}
	.about-inf p{
		font-family: "Lato", sans-serif;
		font-weight: 300;
	}
    .about-inf-text{
        view-timeline-name: --text;
		view-timeline-axis: block;

		animation-timeline: --text;
		animation-name: show;
		animation-range: entry 25% cover 30%;
		animation-fill-mode: both;
    }
	.about-inf img{
		width: 18rem;
		border-radius: 1rem;
		box-shadow: 10px 10px 20px  #3E458D;
		view-timeline-name: --image;
		view-timeline-axis: block;

		animation-timeline: --image;
		animation-name: show;
		animation-range: entry 25% cover 30%;
		animation-fill-mode: both;
	}
    .section2-inf-bottom{
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        width: 90%;
        margin: auto;
    }
    .afiliados-inf{
        width: 250px;
        height: 250px;
        overflow: hidden;
        border-radius: 50%;
        border: 2px solid #3E458D;
        margin: 1.2rem;
        transition: all 0.4s ease;
        position: relative;
        
		view-timeline-name: --afiliados;
		view-timeline-axis: block;

		animation-timeline: --afiliados;
		animation-name: show;
		animation-range: entry 25% cover 30%;
		animation-fill-mode: both;
    }
    .afiliados-inf a{
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
    }
    
    .afiliados-inf img{
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
    .afiliados-inf2 img, .afiliados-inf3 img, .afiliados-inf4 img{
        width: 80%;
    }
    .afiliados-inf::before {
        content: '';
        position: absolute;
        inset: -2px;
        border-radius: 50%;
        background: linear-gradient(45deg, #3E458D, #F4B631);
        opacity: 0;
        z-index: -1;
        transition: opacity 0.4s ease;
    }
    .afiliados-inf:hover{
        transform: scale(1.1) translateY(-5px);
        box-shadow: 0 10px 30px rgba(62, 69, 141, 0.3);
    }
    .afiliados-inf:hover::before {
        opacity: 1;
    }
    .team-work {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }
    .team-work-inf{
        width: 15rem;
        height: 20rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        border: 1px solid #3E458D;
        padding: 1rem;
        border-radius: 2rem;
        margin: 1rem;
        background-color: white;

		view-timeline-name: --team;
		view-timeline-axis: block;

		animation-timeline: --team;
		animation-name: show;
		animation-range: entry 25% cover 30%;
		animation-fill-mode: both;
    }
    .team-work-inf img{
        width: 100%; 
        height: auto;
        aspect-ratio: 1/1;
        object-fit: contain;
        border-radius: 50%;
    }
    .team-work-inf h4{
        font-family: "Lato", sans-serif;
		font-weight: 900;
        padding: 0;
        margin: 0;
        bottom: 0;
    }
    .cargo-work {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-evenly;
        width: 100%;
        padding: 0;
        margin: 0;
        bottom: 0;
    }
    .cargo-work p{
        font-family: "Lato", sans-serif;
        font-weight: 300;
        height: 3rem;
        display: flex;
        align-items: center;
        text-align: left;
        margin: 0;
    }
    .cargo-work img{
        width: 25px;
        transition: transform 0.5s ease;
        border-radius: 0%;
    }
    .cargo-work img:hover{
        transform: scale(1.2);
    }

    @keyframes show {
        from{
            opacity: 0;
            scale: 25%;
        }
        to{
            opacity: 1;
            scale: 100%;
        }
    }

    @media(min-width:375px){
        .about-inf img{
			width: 20em;
		}
    }
    @media (min-width:425px){
		.about-inf img{
			width: 22rem;
		}
	}
    @media(min-width:768px){
		.about-inf img{
			margin-top: 2rem;
		}
		.about-inf-text{
			width: 75%;
		}
	}
@media (min-width:1024px){
        body h2{
            font-size: 3rem;
        }
		.about-inf{
			display: flex;
			flex-direction: row;
			justify-content: space-evenly;
			
		}
		.about-inf2{
			flex-direction: row-reverse;
			text-align: right;

		}
		.about-inf-text{
			width: 50%;	
		}
        .team-work{
            width: 80%;
            margin: auto;
        }
        .team-work-inf{
            width: 200px;
            border-radius: 2rem;
            box-shadow: 0px 10px 12px #3E458D;
            transition: transform .7s ease;
        }
        .team-work-inf:hover{
            transform: scale(1.05);
        }
        .team-work-inf img{
            width: 12rem;
        }
        .cargo-work img{
            width: 25px;
        }
	}
	@media (min-width:1440px){
        body h2{
            font-size: 4.5rem;
        }
		.about-inf{
			margin: 8rem 0rem;
		}
		.about-inf img{
			width: 35rem;
		}
		.about-inf-text{
			width: 40%;
		}
		.about-inf-text h3{
			font-size: 2rem;
		}
		.about-inf-text p{
			font-size: 1.5rem;
        }
        .section2-inf-bottom{
            width: 70%;
            margin-bottom: 4rem;
        }
	}
</style>