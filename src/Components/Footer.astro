---
const footerInformationRigth = [
    {
        id: 1,
        title: 'Productos',
        options: [
            {name: "Guerbet", href: "/Productos/guerbet"},
            {name: "Aptissen", href: "/Productos/aptissen"},
            {name: "Mhj", href: "/Productos/mhj"},
            {name: "Farmavone", href:"/Productos/farmavone"},
            {name: "Temistac", href:"/Productos/termis"},
        ]
    },
    {
        id: 2,
        title: 'Soporte',
        options: [
            {name: "Farmacovigilancia", href: "/farmacovigilancia"},
            {name: "Hacer Pedido", href: "https://wa.link/z4l2bn"},
            {name: "OptiProtect", href: "https://www.guerbet.com/products-solutions/service-support/optiprotecttm-3s"},
            {name: "Quejas y Reclamos", href:"/formularios/quejas-reclamos"},    
        ]
    },
    {
        id: 3,
        title: 'Compañía',
        options: [
            {name: "Acerca de Nosotros" , href:"/about-us"},
            {name: "Noticias y Eventos", href:"/notice&events"},
        ]
    }
];
---
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>footer</title>
</head>
<body>
    <hr>
  <footer class="animate-footer">
    <div class="footer-left">
        <img src="/logo-principal.png" alt="Logo-Jmarting">
        <p>
            Trabajamos con empresas reconocidas alrededor del mundo para garatizar la calidad y variedad.
        </p>
        <ul>
            <li><a href="https://www.instagram.com/synolisvabolivia?igsh=MXUwdnlkaWlxaDdvMw==" target="_blank"><img src="/images/logo-instagram.svg" alt="Instagram"></a></li>
            <li><a href="/" target="_blank"><img src="/images/logo-linkedin.svg" alt="Linkeding"></a></li>
            <li><a href="https://wa.me/59177552039?text=Hola,%20quiero%20comunicarme%20con...%20para..." target="_blank"><img src="/images/logo-whatsapp.svg" alt="Whatsapp"></a></li>
            <li><a href="https://www.tiktok.com/@portal.del.corazon?_r=1&_t=ZM-910nv23MA3g" target="_blank"><img src="/images/tiktok-img.png" alt="TikTok"></a></li>
        </ul>
    </div>
    <div class="footer-rigth">
        <div class="information-rigth">
            {footerInformationRigth.map((footer) =>(
                <div class={`footer-rigth-inf footer-rigth-inf${footer.id}`}>
                    <h3>{footer.title}</h3>
                    <div class="description-right">
                        <ul>
                            {
                                footer.options?.map((options) =>(
                                    <li>
                                        <a href={options.href}>{options.name}</a>
                                    </li>
                                )) 
                            }
                        </ul>
                    </div>
                </div>
            ))

            }
        </div>
    </div>
  </footer>
</body>
</html>
<style>
    hr{
        width: 95%;
        border-top: .1rem solid #3E458D;
        0rem;        
    }
    footer{
        width: 95%;
        margin: auto;
    }
    .information-rigth{
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
        gap: 1rem;
    }
    footer ul{
        padding: 0%;
        list-style-type: none;
    }
    footer a{
        text-decoration: none;
        color: #2D2D2D; 
    }
    .footer-rigth{
        text-align: left;
    }
    .footer-rigth-inf li{
        max-width: 90%;
        line-height: 1.5rem;
    }
    .footer-rigth-inf li{
        transition: transform 0.3s ease;
    }
    .footer-rigth-inf li:hover{
        transform: translateX(5px);
    }
    .footer-rigth-inf a {
        position: relative;
        display: inline-block;
    }
    .footer-rigth-inf a::before {
        content: '';
        position: absolute;
        width: 0;
        height: 1px;
        bottom: -2px;
        left: 0;
        background-color: #3E458D;
        transition: width 0.3s ease;
    }
    .footer-rigth-inf a:hover::before {
        width: 100%;
    }
    .footer-rigth-inf h3{
        color: #3E458D;
    }
    .footer-left{
        max-width: 95%;
        margin: auto;
    }
    .footer-left ul{
        display: flex;
        flex-direction: row;
    }
    .footer-left p{
        color: #2D2D2D;
    }
    .footer-left a img{
        width: 24px;
        margin-right:1rem;
        transition: transform .4s ease, box-shadow 0.3s ease, filter 0.3s ease;
    }
    .footer-left a img:hover{
        transform: scale(1.5) rotate(10deg);
        box-shadow: 0 4px 18px rgba(41, 18, 158, 0.5);
        filter: brightness(1.2);
    }
    .footer-left img{
        width: 12rem;
        margin-top: 1rem;
    }
    @media (min-width:768px){
        footer{
            display: flex;
            flex-wrap: nowrap;
            justify-content: space-between;
            align-items: center;
        }
        .footer-left{
            max-width: 50%;
            margin: 0;
        }
        .footer-left p{
            max-width: 20rem;
        }
        .footer-rigth{
            width: 50%;
        }

    }
</style>