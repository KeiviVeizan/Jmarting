---

const {image, title} = Astro.props
---
<html lang="es">
<head>
    <meta charset="UTF-8">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Bebas+Neue&family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Encabezado-page</title>
</head>
<body>
  <section class="Encabezado-section">
    <div class="Encabezado-content">
        <h2>{title}</h2>
    </div>
    <img src={image} alt="Imagen de fondo de la sección">
    <div class="Encabezado-before"></div>
  </section>
</body>
</html>
<style>
    *{
        margin: 0;
        padding: 0;
    }
    .Encabezado-section{
        width: 100%;
        height: 15vh;
        position: relative;
    }
    .Encabezado-section img{
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 15vh;
        object-fit: cover;
        object-position: 50% 90%;
        z-index: -2;
        
    }
    .Encabezado-before{
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 15vh;
        background: #1c1c1d;
        opacity: .8;
        z-index: -1;
    }
    .Encabezado-content h2{
        z-index: 4;
        color: white;
        padding-top: 30px;
        font-size: 2.5rem;
        text-align: center;
        font-family: "Bebas Neue", sans-serif;
        font-weight: 700;
    }
    @media(min-width:768px){
        .Encabezado-section{
            height: 25vh;
        }
        .Encabezado-section img{
            height: 25vh;
        }
        .Encabezado-before{
            height: 25vh;
        }
        .Encabezado-content h2{
            font-size: 4rem;
            padding-top: 50px;
        }
    }
    @media(min-width:1024px){
        .Encabezado-content h2{
            font-size: 6rem;
            padding-top: 30px;
        }
    }
     @media(min-width:1440px){
        .Encabezado-content h2{
            font-size: 8rem;
            padding-top: 25px;
        }
    }
</style>