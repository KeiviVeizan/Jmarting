---
const { image, title } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png+xml" href="/logo-simple.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Encabezado-page</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Bebas+Neue&family=Kanit:wght@400;700&family=Lato:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <section class="Encabezado-section">
      <img src={image} alt="Imagen de fondo de la sección" />
      <div class="Encabezado-overlay"></div>
      <div class="Encabezado-content">
        <h2>{title}</h2>
      </div>
    </section>
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .Encabezado-section {
    position: relative;
    width: 100%;
    height: 25vh;
    min-height: 180px;
    max-height: 400px;
    overflow: hidden;
  }

  .Encabezado-section img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -2;
  }

  .Encabezado-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #1c1c1d;
    opacity: 0.7;
    z-index: -1;
  }

  .Encabezado-content {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .Encabezado-content h2 {
    color: white;
    font-size: 2.5rem;
    font-family: "Bebas Neue", sans-serif;
    padding: 0 1rem;
  }

  /* Responsive */
  @media (min-width: 768px) {
    .Encabezado-content h2 {
      font-size: 4rem;
    }
  }

  @media (min-width: 1024px) {
    .Encabezado-content h2 {
      font-size: 6rem;
    }
  }

  @media (min-width: 1440px) {
    .Encabezado-content h2 {
      font-size: 8rem;
    }
  }
</style>
