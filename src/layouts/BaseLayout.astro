---
import Footer from "../Components/Footer.astro"
import Header from "../Components/Header.astro"
---
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Component header, footer</title>
</head>
<body>
  <Header/>
  <main>
    <div id="preloader">
      <img id="loader-logo" src="/logo-simple.png" alt="Logo" />
    </div>
    <slot/>
  </main>
  <Footer/>
</body>
</html>
<script type="text/javascript">
      window.onload = function(){
      (function(d, script) {
      script = d.createElement('script');
      script.type = 'text/javascript';
      script.async = true;
      script.src = 'https://w.app/widget-v1/Bhl93A.js';
      d.getElementsByTagName('head')[0].appendChild(script);
      }(document));
      };
</script>
<style>
#preloader {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  transition: opacity 0.5s ease, visibility 0.5s ease;
}

#loader-logo {
  width: 80px;
  height: auto;
  animation: pulse 1s ease-in-out infinite;
  transition: all 0.8s ease-in-out;
}

/* Palpitación */
@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.2);
  }
}

/* Clase para moverlo arriba a la izquierda */
#preloader.loaded #loader-logo {
  position: fixed;
  top: 1rem; /* Igual a tu header */
  left: 1rem;
  width: 40px;
  animation: none;
  transform: scale(1);
}

/* Cuando termina la transición, ocultamos el preloader */
#preloader.loaded {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
</style>
<script is:browser>
  window.addEventListener("load", () => {
    const preloader = document.getElementById("preloader");
    preloader.classList.add("loaded");

    // Quitamos el preloader después de la animación
    setTimeout(() => {
      preloader.remove();
    }, 1000); // espera a que se desplace y desaparezca
  });
</script>

